+// 32-bit ARM has no 64-bit atomics. These counters are statistics only, so a tiny spinlock
+// protects them on every target without changing their semantics.
+var u64_counter_lock: std.atomic.Value(u32) = .init(0);
+fn u64CounterAdd(ptr: *u64, value: u64) void {
+    while (u64_counter_lock.cmpxchgWeak(0, 1, .acquire, .monotonic) != null) std.atomic.spinLoopHint();
+    ptr.* +%= value;
+    u64_counter_lock.store(0, .release);
+}
+fn u64CounterLoad(ptr: *u64) u64 {
+    while (u64_counter_lock.cmpxchgWeak(0, 1, .acquire, .monotonic) != null) std.atomic.spinLoopHint();
+    const value = ptr.*;
+    u64_counter_lock.store(0, .release);
+    return value;
+}
